# ---- Server ----
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/smartbirth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PUBLIC_VERIFY_URL=http://localhost:5173/verify

# ---- Email (leave blank to use console mock) ----
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# ---- Cloudinary (optional) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMS (only 'mock' is implemented; it logs masked numbers, no paid API needed) ----
SMS_PROVIDER=mock

UPLOAD_DIR=uploads

# ---- DEMO / MOCK services (never real UIDAI/biometric) ----
MOCK_OTP=true
MOCK_AADHAAR=true
MOCK_BIOMETRIC=true
